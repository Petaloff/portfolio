# Public site URL, used for metadata, RSS and sitemap
NEXT_PUBLIC_SITE_URL=https://www.petaloff.space

# Search engine ownership tokens: the content value of each verification meta tag
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Optional: raises the GitHub API rate limit for live stats
GITHUB_TOKEN=

# PostHog (EU). The consent banner appears only when a key is set
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Giscus comments, values from https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=Petaloff/portfolio
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Minecraft: server address for the live status block (shows "planned" while empty)
MC_SERVER_ADDRESS=
# Minecraft username whose skin is shown (defaults to Steve)
NEXT_PUBLIC_MC_USERNAME=

# Guestbook sign-in (Auth.js). Generate the secret with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth app, callback URL: <site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Discord application OAuth2, redirect: <site>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Guestbook storage: Upstash Redis (the Vercel integration sets KV_REST_API_*)
KV_REST_API_URL=
KV_REST_API_TOKEN=
