# Public site URL, used for metadata, RSS and sitemap
NEXT_PUBLIC_SITE_URL=https://petaloff.vercel.app

# Optional: raises the GitHub API rate limit for live stats
GITHUB_TOKEN=

# PostHog (EU). The consent banner appears only when a key is set
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Giscus comments, values from https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=Petaloff/portfolio
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Minecraft: server address for the live status block (shows "planned" while empty)
MC_SERVER_ADDRESS=
# Minecraft username whose skin is shown (defaults to Steve)
NEXT_PUBLIC_MC_USERNAME=
